{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "Email Manager - Email Sends API",
		"description": "Collection for listing and filtering submitted Email Sends.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Get All Email Sends",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/email-manager/sends",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"email-manager",
						"sends"
					]
				},
				"description": "Retrieves the summary list of all submitted email sends (including totalRecipients and externalRecipients)."
			},
			"response": []
		},
		{
			"name": "Get Email Sends by Submitter",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/email-manager/sends?submittedBy=jdoe",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"email-manager",
						"sends"
					],
					"query": [
						{
							"key": "submittedBy",
							"value": "jdoe",
							"description": "Username or email of the user who submitted the send"
						}
					]
				},
				"description": "Retrieves email sends filtered by the 'submittedBy' query parameter."
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		}
	]
}