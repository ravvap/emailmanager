{
  "info": {
    "_postman_id": "a82b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d",
    "name": "Email Manager API Collection",
    "description": "Postman collection for testing Data Connection, No-Reply Mailbox, and Internal Domain Allowlist APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "userName",
      "value": "adminUser",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Data Connections",
      "item": [
        {
          "name": "Get All Connections",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/data-connections",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "data-connections"]
            }
          }
        },
        {
          "name": "Get Connection by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/data-connections/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "data-connections", "1"]
            }
          }
        },
        {
          "name": "Create Connection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Name",
                "value": "{{userName}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Primary DB Connection\",\n  \"databaseLocationId\": 1,\n  \"status\": \"ACTIVE\",\n  \"authorUserIds\": [100, 101],\n  \"password\": \"optional_dev_password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/data-connections",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "data-connections"]
            }
          }
        },
        {
          "name": "Update Connection",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Name",
                "value": "{{userName}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"name\": \"Updated DB Connection\",\n  \"databaseLocationId\": 1,\n  \"status\": \"ACTIVE\",\n  \"authorUserIds\": [100]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/data-connections/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "data-connections", "1"]
            }
          }
        },
        {
          "name": "Test Connection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"databaseLocationId\": 1,\n  \"password\": \"dev_password_override\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/data-connections/test",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "data-connections", "test"]
            }
          }
        },
        {
          "name": "Delete Connection",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-User-Name",
                "value": "{{userName}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/data-connections/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "data-connections", "1"]
            }
          }
        }
      ]
    },
