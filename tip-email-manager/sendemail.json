            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{makerToken}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"templateId\": {{queryTemplateId}},\n  \"queryParameters\": {\n    \"status\": \"ACTIVE\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.expect(pm.response.code).to.eql(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('externalRejectSendId', j.sendId);"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Reject External Send with Mandatory Reason (Checker)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/email-manager/sends/external-approvals/{{externalRejectSendId}}/decision",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "email-manager", "sends", "external-approvals", "{{externalRejectSendId}}", "decision"]
            },
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{checkerToken}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approved\": false,\n  \"comments\": \"Confirm partner-agency list before re-submitting.\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.expect(pm.response.code).to.eql(200));",
                  "const j = pm.response.json();",
                  "pm.test('Status is REJECTED_BY_REVIEWER', () => pm.expect(j.status).to.eql('REJECTED_BY_REVIEWER'));",
                  "pm.test('CSV export disabled for rejected send', () => pm.expect(j.canExportFailedCsv).to.eql(false));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Scenario 4: Send via Excel Upload & Submitter Cancellation",
      "item": [
